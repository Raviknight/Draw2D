<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>DrawingKit</name>
  <description>Community add-on for the TechDraw workbench: Onshape-style drawings with sized sheets and a clean title block, fitted standard views, projected views by pointing, click-defined and stepped sections, detail views, centre marks with bolt circles, hole callouts, datum flags and geometric tolerance frames.</description>
  <version>0.14.5</version>
  <date>2026-11-25</date>
  <maintainer email="101029458+Raviknight@users.noreply.github.com">Raviknight</maintainer>
  <license file="LICENSE">LGPL-2.1-or-later</license>
  <url type="repository" branch="main">https://github.com/Raviknight/DrawingKit</url>
  <url type="bugtracker">https://github.com/Raviknight/DrawingKit/issues</url>
  <url type="readme">https://github.com/Raviknight/DrawingKit/blob/main/README.md</url>
  <icon>DrawingKitTools/Resources/icons/DrawingKit.svg</icon>

  <content>
    <workbench>
      <classname>DrawingKitWorkbench</classname>
      <subdirectory>./</subdirectory>
      <icon>DrawingKitTools/Resources/icons/DrawingKit.svg</icon>
      <freecadmin>1.1.0</freecadmin>
      <depend type="internal">TechDraw</depend>
      <tag>TechDraw</tag>
      <tag>drawing</tag>
      <tag>2D</tag>
    </workbench>
  </content>
</package>
